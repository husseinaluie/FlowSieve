void build_LHS_matrix(
        dataset * coarsened_grid,
        Eigen::SparseMatrix<double> & LHS,
        const double & delta_t,
        const std::vector<short int> & ill_conditioned
        ) {

    const std::vector<double>   &latitude   = coarsened_grid->latitude,
                                &longitude  = coarsened_grid->longitude;
    const std::vector<int>  &myCounts = coarsened_grid->myCounts;

    const int   Ntime  = myCounts.at(0),
                Ndepth = myCounts.at(1),
                Nlat   = (constants::GRID_TYPE == constants::GridType::MeshGrid) ? myCounts.at(2) : 1,
                Nlon   = (constants::GRID_TYPE == constants::GridType::MeshGrid) ? myCounts.at(3) : 1;
    const size_t Npts  = (constants::GRID_TYPE == constants::GridType::MeshGrid) ? Nlat*Nlon : latitude.size();


    size_t Ipt, In, Jn;

    const size_t num_neighbours = coarsened_grid->num_neighbours+1;
    const size_t num_triplets = Npts * num_neighbours * num_neighbours; // rough estimate

    typedef Eigen::Triplet<double> T;
    std::vector< Eigen::Triplet<double> > triplets( Npts + num_triplets );


    #pragma omp parallel default(none) private( Ipt, In, Jn ) \
    firstprivate( Ntime, Ndepth, Nlat, Nlon, Npts, delta_t, num_neighbours ) \
    shared( coarsened_grid, triplets, ill_conditioned )
    {

        #pragma omp for collapse(1) schedule(guided)
        for ( Ipt = 0; Ipt < Npts; Ipt++ ) {

            triplets[Ipt] = T(Ipt, Ipt, 1); // adding the diagonal
    
            double cos_lat_I = cos( coarsened_grid->latitude[Ipt] );

            double area_I = coarsened_grid->areas[Ipt];

            for ( In = 0; In < coarsened_grid->num_neighbours+1; In++ ) {
                size_t Jpt = coarsened_grid->adjacency_indices[Ipt][In];

                double cos_lat_J = cos( coarsened_grid->latitude[Jpt] );

                double dlon_weight_I = coarsened_grid->adjacency_ddlon_weights[Ipt][In];
                double dlat_weight_I = coarsened_grid->adjacency_ddlat_weights[Ipt][In];

                for ( Jn = 0; Jn < coarsened_grid->num_neighbours+1; Jn++ ) {
                    size_t Kpt = coarsened_grid->adjacency_indices[Jpt][Jn];

                    double cos_lat_K = cos( coarsened_grid->latitude[Kpt] );

                    double dlon_weight_J = coarsened_grid->adjacency_ddlon_weights[Jpt][Jn];
                    double dlat_weight_J = coarsened_grid->adjacency_ddlat_weights[Jpt][Jn];


                    size_t triplet_index = Npts + (Ipt * num_neighbours + In) * num_neighbours + Jn;

                    double val;
                    if ( ill_conditioned[Ipt] ) {
                        val = 0.;
                    } else {
                        val = dlon_weight_I * dlon_weight_J / ( constants::R_earth * cos_lat_K )
                            + dlat_weight_I * dlat_weight_J * cos_lat_J / constants::R_earth;
                        val /= constants::R_earth * cos_lat_I;// * area_I;
                    }

                    triplets[triplet_index] = T( Ipt, Kpt, - delta_t * val );
                }
            }
        }
    } 

    LHS.resize( Npts, Npts );
    LHS.setFromTriplets(triplets.begin(), triplets.end());
    LHS.makeCompressed();


}


void get_true_vort_div_fast(
        dataset * coarsened_grid,
        dataset & PsiPhi_grid
            ) {

    // Similar to get_vels_vort_and_div, except this manually implements the derivatives
    // By lumping all of the derivative calculations together we can be more efficient, especially
    // with the threading.


    const std::vector<double>   &latitude   = coarsened_grid->latitude,
                                &longitude  = coarsened_grid->longitude;
    const std::vector<int>  &myCounts = coarsened_grid->myCounts;

    const int   Ntime  = myCounts.at(0),
                Ndepth = myCounts.at(1),
                Nlat   = (constants::GRID_TYPE == constants::GridType::MeshGrid) ? myCounts.at(2) : 1,
                Nlon   = (constants::GRID_TYPE == constants::GridType::MeshGrid) ? myCounts.at(3) : 1;
    const size_t Npts  = (constants::GRID_TYPE == constants::GridType::MeshGrid) ? Nlat*Nlon : latitude.size();


    size_t Ipt, In;

    // zero out the fields
    #pragma omp parallel default(none) private( Ipt ) \
    shared( coarsened_grid ) firstprivate( Npts )
    {
        #pragma omp for collapse(1) schedule(static)
        for ( Ipt = 0; Ipt < Npts; Ipt++ ) {

            #ifdef NDEBUG
            coarsened_grid->variables["vort"][Ipt] = 0;
            coarsened_grid->variables["div"][Ipt]  = 0;
            #else
            coarsened_grid->variables.at("vort")[Ipt] = 0;
            coarsened_grid->variables.at("div")[Ipt]  = 0;
            #endif
        }
    }

    //
    // loop to get vorticity and divergence
    //

    #pragma omp parallel default(none) private( Ipt, In ) \
    firstprivate( Ntime, Ndepth, Nlat, Nlon, Npts ) \
    shared( coarsened_grid, PsiPhi_grid )
    {

        #pragma omp for collapse(1) schedule(guided)
        for ( Ipt = 0; Ipt < Npts; Ipt++ ) {
            double cos_lat  = cos( coarsened_grid->latitude[Ipt] );
            for ( In = 0; In < coarsened_grid->num_neighbours+1; In++ ) {
                size_t Jpt = coarsened_grid->adjacency_indices[Ipt][In];

                double dlon_weight, dlat_weight;
                const bool use_adjoint = false;
                if ( (use_adjoint) and (coarsened_grid->adjacency_indices_adjoint.size() > 0) ) {
                    size_t Jn = coarsened_grid->adjacency_indices_adjoint[Ipt][In];
                    dlon_weight = -coarsened_grid->adjacency_ddlon_weights[Jpt][Jn];
                    dlat_weight = -coarsened_grid->adjacency_ddlat_weights[Jpt][Jn];
                } else {
                    dlon_weight = coarsened_grid->adjacency_ddlon_weights[Ipt][In];
                    dlat_weight = coarsened_grid->adjacency_ddlat_weights[Ipt][In];
                }

                double cos_Jlat = cos( coarsened_grid->latitude[Jpt] );

                #ifdef NDEBUG
                coarsened_grid->variables["vort"][Ipt] += 
                    (   dlon_weight * coarsened_grid->variables.at("u_lat")[Jpt]
                      - dlat_weight * coarsened_grid->variables.at("u_lon")[Jpt] * cos_Jlat
                    ) / (constants::R_earth * cos_lat);

                coarsened_grid->variables["div"][Ipt] += 
                    (   dlon_weight * coarsened_grid->variables.at("u_lon")[Jpt]
                      + dlat_weight * coarsened_grid->variables.at("u_lat")[Jpt] * cos_Jlat
                    ) / (constants::R_earth * cos_lat);
                #else
                coarsened_grid->variables.at("vort")[Ipt] += 
                    (   dlon_weight * coarsened_grid->variables.at("u_lat")[Jpt]
                      - dlat_weight * coarsened_grid->variables.at("u_lon")[Jpt] * cos_Jlat
                    ) / (constants::R_earth * cos_lat);

                coarsened_grid->variables.at("div")[Ipt] += 
                    (   dlon_weight * coarsened_grid->variables.at("u_lon")[Jpt]
                      + dlat_weight * coarsened_grid->variables.at("u_lat")[Jpt] * cos_Jlat
                    ) / (constants::R_earth * cos_lat);
                #endif

            }
        }
    }


}

void get_vels_vort_and_div_fast(
        dataset * coarsened_grid,
        dataset & PsiPhi_grid
            ) {

    // Similar to get_vels_vort_and_div, except this manually implements the derivatives
    // By lumping all of the derivative calculations together we can be more efficient, especially
    // with the threading.


    const std::vector<double>   &latitude   = coarsened_grid->latitude,
                                &longitude  = coarsened_grid->longitude;
    const std::vector<int>  &myCounts = coarsened_grid->myCounts;

    const int   Ntime  = myCounts.at(0),
                Ndepth = myCounts.at(1),
                Nlat   = (constants::GRID_TYPE == constants::GridType::MeshGrid) ? myCounts.at(2) : 1,
                Nlon   = (constants::GRID_TYPE == constants::GridType::MeshGrid) ? myCounts.at(3) : 1;
    const size_t Npts  = (constants::GRID_TYPE == constants::GridType::MeshGrid) ? Nlat*Nlon : latitude.size();


    size_t Ipt, In;

    // zero out the fields
    #pragma omp parallel default(none) private( Ipt ) \
    shared( coarsened_grid ) firstprivate( Npts )
    {
        #pragma omp for collapse(1) schedule(static)
        for ( Ipt = 0; Ipt < Npts; Ipt++ ) {

            #ifdef NDEBUG
            coarsened_grid->variables["proj_uo_tor"][Ipt] = 0; 
            coarsened_grid->variables["proj_vo_tor"][Ipt] = 0;  
            coarsened_grid->variables["proj_uo_pot"][Ipt] = 0;
            coarsened_grid->variables["proj_vo_pot"][Ipt] = 0;

            coarsened_grid->variables["proj_vort"][Ipt] = 0;
            coarsened_grid->variables["proj_div"][Ipt]  = 0;
            #else
            coarsened_grid->variables.at("proj_uo_tor")[Ipt] = 0; 
            coarsened_grid->variables.at("proj_vo_tor")[Ipt] = 0;  
            coarsened_grid->variables.at("proj_uo_pot")[Ipt] = 0;
            coarsened_grid->variables.at("proj_vo_pot")[Ipt] = 0;

            coarsened_grid->variables.at("proj_vort")[Ipt] = 0;
            coarsened_grid->variables.at("proj_div")[Ipt]  = 0;
            #endif
        }
    }


    //
    // First loop set gets the velocity components
    //

    #pragma omp parallel default(none) private( Ipt, In ) \
    firstprivate( Ntime, Ndepth, Nlat, Nlon, Npts ) \
    shared( coarsened_grid, PsiPhi_grid )
    {

        #pragma omp for collapse(1) schedule(guided)
        for ( Ipt = 0; Ipt < Npts; Ipt++ ) {
            double cos_lat = cos( coarsened_grid->latitude[Ipt] );
            for ( In = 0; In < coarsened_grid->num_neighbours+1; In++ ) {
                size_t Jpt = coarsened_grid->adjacency_indices[Ipt][In];

                double dlon_weight = coarsened_grid->adjacency_ddlon_weights[Ipt][In];
                double dlat_weight = coarsened_grid->adjacency_ddlat_weights[Ipt][In];


                #ifdef NDEBUG
                coarsened_grid->variables["proj_uo_tor"][Ipt] += 
                    - dlat_weight * PsiPhi_grid.variables.at("Psi")[Jpt] /  constants::R_earth;
                coarsened_grid->variables["proj_vo_tor"][Ipt] +=   
                      dlon_weight * PsiPhi_grid.variables.at("Psi")[Jpt] / (constants::R_earth * cos_lat);

                coarsened_grid->variables["proj_uo_pot"][Ipt] += 
                      dlon_weight * PsiPhi_grid.variables.at("Phi")[Jpt] / (constants::R_earth * cos_lat);
                coarsened_grid->variables["proj_vo_pot"][Ipt] += 
                      dlat_weight * PsiPhi_grid.variables.at("Phi")[Jpt] /  constants::R_earth;
                #else
                coarsened_grid->variables.at("proj_uo_tor")[Ipt] += 
                    - dlat_weight * PsiPhi_grid.variables.at("Psi")[Jpt] /  constants::R_earth;
                coarsened_grid->variables.at("proj_vo_tor")[Ipt] +=   
                      dlon_weight * PsiPhi_grid.variables.at("Psi")[Jpt] / (constants::R_earth * cos_lat);

                coarsened_grid->variables.at("proj_uo_pot")[Ipt] += 
                      dlon_weight * PsiPhi_grid.variables.at("Phi")[Jpt] / (constants::R_earth * cos_lat);
                coarsened_grid->variables.at("proj_vo_pot")[Ipt] += 
                      dlat_weight * PsiPhi_grid.variables.at("Phi")[Jpt] /  constants::R_earth;
                #endif
            }
        }
    }


    //
    // Second loop sets gets vorticity and divergence
    //

    #pragma omp parallel default(none) private( Ipt, In ) \
    firstprivate( Ntime, Ndepth, Nlat, Nlon, Npts ) \
    shared( coarsened_grid, PsiPhi_grid )
    {

        #pragma omp for collapse(1) schedule(guided)
        for ( Ipt = 0; Ipt < Npts; Ipt++ ) {
            double cos_lat  = cos( coarsened_grid->latitude[Ipt] );
            for ( In = 0; In < coarsened_grid->num_neighbours+1; In++ ) {
                size_t Jpt = coarsened_grid->adjacency_indices[Ipt][In];

                double dlon_weight, dlat_weight;
                const bool use_adjoint = false;
                if ( (use_adjoint) and (coarsened_grid->adjacency_indices_adjoint.size() > 0) ) {
                    size_t Jn = coarsened_grid->adjacency_indices_adjoint[Ipt][In];
                    dlon_weight = -coarsened_grid->adjacency_ddlon_weights[Jpt][Jn];
                    dlat_weight = -coarsened_grid->adjacency_ddlat_weights[Jpt][Jn];
                } else {
                    dlon_weight = coarsened_grid->adjacency_ddlon_weights[Ipt][In];
                    dlat_weight = coarsened_grid->adjacency_ddlat_weights[Ipt][In];
                }

                double cos_Jlat = cos( coarsened_grid->latitude[Jpt] );

                #ifdef NDEBUG
                coarsened_grid->variables["proj_vort"][Ipt] += 
                    (   dlon_weight * coarsened_grid->variables.at("proj_vo_tor")[Jpt]
                      - dlat_weight * coarsened_grid->variables.at("proj_uo_tor")[Jpt] * cos_Jlat
                    ) / (constants::R_earth * cos_lat);

                coarsened_grid->variables["proj_div"][Ipt] += 
                    (   dlon_weight * coarsened_grid->variables.at("proj_uo_pot")[Jpt]
                      + dlat_weight * coarsened_grid->variables.at("proj_vo_pot")[Jpt] * cos_Jlat
                    ) / (constants::R_earth * cos_lat);
                #else
                coarsened_grid->variables.at("proj_vort")[Ipt] += 
                    (   dlon_weight * coarsened_grid->variables.at("proj_vo_tor")[Jpt]
                      - dlat_weight * coarsened_grid->variables.at("proj_uo_tor")[Jpt] * cos_Jlat
                    ) / (constants::R_earth * cos_lat);

                coarsened_grid->variables.at("proj_div")[Ipt] += 
                    (   dlon_weight * coarsened_grid->variables.at("proj_uo_pot")[Jpt]
                      + dlat_weight * coarsened_grid->variables.at("proj_vo_pot")[Jpt] * cos_Jlat
                    ) / (constants::R_earth * cos_lat);
                #endif

            }
        }
    }


}

